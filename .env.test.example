# Copie para .env.test depois de criar um projeto Supabase separado para testes.
# Use somente a URL do projeto de teste e a chave anon/publishable pública dele.
WY_TEST_SUPABASE_URL=https://SEU_PROJETO_DE_TESTE.supabase.co
WY_TEST_SUPABASE_ANON_KEY=COLE_A_CHAVE_ANON_OU_PUBLISHABLE_DO_PROJETO_DE_TESTE
